# URL of the AEGIS mock backend (P2). No trailing slash.
AEGIS_MOCK_API_URL=http://127.0.0.1:8000

# Port this service runs on.
AEGIS_QA_PORT=8001

# Google Gemini API key and model for remote VQA
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional local ViLT VQA (set to "true" only if torch and transformers are installed)
AEGIS_VQA_ENABLED=false
AEGIS_VQA_MODEL=dandelin/vilt-b32-finetuned-vqa
